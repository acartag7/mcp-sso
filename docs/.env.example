# mcp-sso example configuration. Copy to .env and fill in.
# Full reference: configuration.md (same directory).  NEVER commit a populated .env.
# Secrets (🔒) belong in a secret manager in production. This file is a template.

# --- Bridge (required for any real identity provider) ---
# STOP: replace all four uncommented values in this section. Configuring only an
# identity-provider block leaves an unusable issuer, resource, and signing keys.
# The examples enable CIMD and DCR together. fastify-sqlite defaults to stateless;
# use stored DCR when registrations must survive restart. Both modes support
# explicitly allowlisted native CLI loopback callbacks.
# Reachable HTTPS profile:
OAUTH_ISSUER=https://mcp.example.com
OAUTH_RESOURCE=https://mcp.example.com/mcp
# Local development profile instead:
# OAUTH_ISSUER=http://127.0.0.1:3000
# OAUTH_RESOURCE=http://127.0.0.1:3000/mcp
# OAUTH_ALLOW_INSECURE_LOCALHOST=true
# 🔒 HS256 consent secret. Generate one with `openssl rand -hex 32`.
OAUTH_CONSENT_SIGNING_SECRET=replace-with-a-32-plus-char-random-secret
# 🔒 ES256 signing key as a JSON JWK (private). Generate one; do not reuse this placeholder.
OAUTH_SIGNING_PRIVATE_JWK={"kty":"EC","crv":"P-256","d":"REPLACE","x":"REPLACE","y":"REPLACE"}
# Optional bridge tuning (defaults shown):
# OAUTH_SCOPE_CATALOG=mcp:read,mcp:write
# OAUTH_DEFAULT_SCOPES=mcp:read
# OAUTH_ALLOWED_ORIGINS=https://mcp.example.com,https://claude.ai
# fastify-sqlite production only: exact stateless|stored (default stateless).
# Native CLIs need the explicit loopback origins shown below; choose stored when
# their registrations must survive restart.
# OAUTH_DCR_MODE=stored
# Optional under the default extend mode. Add only callbacks used by real opaque
# DCR clients; native CLIs need both loopback origins. Replace the application
# placeholder or omit it when no such application uses it.
# OAUTH_REDIRECT_ALLOWLIST=https://your-client.example/callback,http://localhost,http://127.0.0.1
# OAUTH_REDIRECT_ALLOWLIST_MODE=extend  # replace trusts only the entries above
# OAUTH_ALLOW_INSECURE_LOCALHOST=false   # dev only; local profile above uses true

# --- Identity provider: choose exactly ONE block ---
# Multiple selector variables are an ambiguous security configuration and fail boot.

# Cloudflare Access
# CF_ACCESS_AUDIENCE=your-app-hex-aud-tag
# CF_ACCESS_CERTS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
# CF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# CF_ACCESS_EMAIL_ALLOWLIST=

# Microsoft Entra ID
# ENTRA_TENANT_ID=<tenant-guid>
# ENTRA_CLIENT_ID=<app-client-id>
# ENTRA_CLIENT_SECRET=            # 🔒 omit for a public (PKCE) client
# ENTRA_REDIRECT_URI=https://mcp.example.com/oauth/callback
# ENTRA_ALLOWED_TENANT_IDS=
# ENTRA_SUBJECT_ALLOWLIST=
# ENTRA_GROUP_AUTHORIZATION_JSON={"mapping":{"00000000-0000-0000-0000-000000000001":["mcp:read"]},"baseScopes":[]}

# Google
# GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=           # 🔒
# GOOGLE_REDIRECT_URI=https://mcp.example.com/oauth/callback
# GOOGLE_HOSTED_DOMAIN=
# GOOGLE_SUBJECT_ALLOWLIST=
# GOOGLE_ALLOW_EMAIL_ALLOWLIST=false

# Generic OIDC (Keycloak, Okta, Auth0, Dex, …)
# OIDC_ISSUER=https://idp.example.com/realms/main
# OIDC_CLIENT_ID=mcp-bridge
# OIDC_CLIENT_SECRET=             # 🔒 omit for a public (PKCE) client
# OIDC_REDIRECT_URI=https://mcp.example.com/oauth/callback
# OIDC_SCOPES=openid profile email
# OIDC_SUBJECT_ALLOWLIST=

# --- Runtime (optional) ---
# MCP_SSO_DIR=./.mcp-sso
# PORT=3000
# HOST=0.0.0.0
# Exact IP/CIDR allowlist for proxy sockets that Fastify may trust when resolving
# client IPs. Leave unset for direct connections; never use client-controlled ranges.
# MCP_SSO_TRUSTED_PROXIES=127.0.0.1,::1
# With no real IdP selector, HOST must remain localhost/127.0.0.1/::1. The
# deliberately unsafe break-glass escape below is for temporary testing only:
# MCP_SSO_UNSAFE_ALLOW_NON_LOOPBACK_PAIRING=false

# --- api-key-gateway example only ---
# BACKEND_API_KEY=                # 🔒 the static credential injected for the backend MCP
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8788
