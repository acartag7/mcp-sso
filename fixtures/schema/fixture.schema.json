{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acartag7/mcp-sso/fixtures/schema/fixture.schema.json",
  "title": "mcp-sso parity fixture",
  "description": "One executable statement of one contract clause. Governed by docs/contracts/19-parity-fixture-protocol.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "profile",
    "contract",
    "status",
    "given",
    "when",
    "then"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "<NN>-<section-slug>/<clause>-<slug>; must equal the file path relative to fixtures/ without .json",
      "pattern": "^(0[1-9]|1[0-9])-[a-z0-9]+(-[a-z0-9]+)*/[0-9]+(\\.[0-9]+){0,2}[a-z]?-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "profile": {
      "enum": [
        "portable",
        "host"
      ],
      "description": "portable pins shared OAuth behavior; host pins the TypeScript reference envelope"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "clause",
        "quote"
      ],
      "properties": {
        "section": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-9])$"
        },
        "clause": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}[a-z]?$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "Verbatim normative text this fixture pins"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "superseded"
      ]
    },
    "supersededBy": {
      "type": "string",
      "description": "Fixture id; required when status is superseded"
    },
    "notes": {
      "type": "string",
      "description": "What is deliberately not asserted and why"
    },
    "given": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "clock",
        "random",
        "keys",
        "state",
        "http",
        "identity",
        "rateLimit",
        "protectedResource"
      ],
      "properties": {
        "config": {
          "$ref": "#/$defs/fixtureConfig"
        },
        "clock": {
          "type": "string",
          "description": "Canonical run timestamp, UTC ISO 8601 with exactly 3 ms digits (section 12.1)",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "random": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed"
          ],
          "properties": {
            "seed": {
              "type": "string",
              "minLength": 1,
              "description": "UTF-8 input to the section 19.2 HMAC-SHA-256 byte stream; maximum 1,024 UTF-8 bytes"
            }
          }
        },
        "keys": {
          "type": "object",
          "description": "Logical name to a PEM path under fixtures/keys/",
          "additionalProperties": false,
          "required": [
            "signingPrivate"
          ],
          "properties": {
            "signingPrivate": {
              "type": "string",
              "pattern": "^keys/[a-z0-9-]+\\.pem$"
            },
            "signingPublic": {
              "type": "string",
              "pattern": "^keys/[a-z0-9-]+\\.pem$"
            }
          }
        },
        "state": {
          "type": "object",
          "description": "Pre-existing store rows, keyed by record kind, in the section 12.1 record shapes",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "http": {
          "type": "array",
          "description": "Every outbound exchange the implementation may perform; an unmatched outbound call fails the fixture",
          "items": {
            "$ref": "#/$defs/exchange"
          }
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "rateLimit": {
          "$ref": "#/$defs/rateLimit"
        },
        "protectedResource": {
          "$ref": "#/$defs/protectedResource"
        }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/inboundRequest"
        }
      }
    },
    "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "outbound"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "description": "Lower-case header name to matcher; a header not listed is not asserted",
          "propertyNames": {
            "$ref": "#/$defs/headerName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/matcher"
          }
        },
        "body": {
          "$ref": "#/$defs/matcher"
        },
        "audit": {
          "$ref": "#/$defs/auditAssertion"
        },
        "state": {
          "$ref": "#/$defs/stateAssertion"
        },
        "outbound": {
          "type": "array",
          "description": "Exact ordered list of outbound calls that MUST have happened; empty means none",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "url",
              "headers",
              "body"
            ],
            "properties": {
              "method": {
                "type": "string",
                "pattern": "^[A-Z]+$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headers": {
                "type": "object",
                "description": "Exact outbound header-name set; each lower-case name maps to a value matcher",
                "propertyNames": {
                  "$ref": "#/$defs/headerName"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/presentMatcher"
                }
              },
              "body": {
                "$ref": "#/$defs/matcher"
              }
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which implementation passed this fixture unchanged, at which version and commit, on which date. Required when status is frozen.",
      "required": [
        "implementation",
        "version",
        "commit",
        "date"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  },
  "$defs": {
    "fixtureConfig": {
      "type": "object",
      "description": "Complete JSON fixture configuration for section 05. given.keys.signingPrivate materializes signingPrivateJwk; stored mode materializes its store from given.state.",
      "additionalProperties": false,
      "required": [
        "issuer",
        "resource",
        "consentSigningSecret",
        "redirectAllowlist",
        "scopeCatalog",
        "defaultScopes",
        "allowedOrigins",
        "dcr",
        "accessTokenTtlSeconds",
        "refreshTokenTtlSeconds",
        "consentTokenTtlSeconds",
        "authorizationCodeTtlSeconds"
      ],
      "properties": {
        "issuer": { "type": "string", "format": "uri" },
        "resource": { "type": "string", "format": "uri" },
        "consentSigningSecret": { "type": "string", "minLength": 32 },
        "signingKeyId": { "type": "string", "minLength": 1 },
        "redirectAllowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "redirectAllowlistMode": { "enum": ["extend", "replace"] },
        "scopeCatalog": { "$ref": "#/$defs/stringArray" },
        "defaultScopes": { "$ref": "#/$defs/stringArray" },
        "scopeHierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "implications"],
          "properties": {
            "resource": { "type": "string", "format": "uri" },
            "implications": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["granted", "implies"],
                "properties": {
                  "granted": { "type": "string" },
                  "implies": { "$ref": "#/$defs/stringArray" }
                }
              }
            }
          }
        },
        "allowedOrigins": { "$ref": "#/$defs/stringArray" },
        "dcr": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "stateless" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "stored" } }
            }
          ]
        },
        "dev": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowInsecureLocalhost"],
          "properties": { "allowInsecureLocalhost": { "type": "boolean" } }
        },
        "clientCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "cimd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "const": true },
            "maxDocumentBytes": { "type": "integer" },
            "fetchTimeoutMs": { "type": "integer" },
            "cacheTtlCapSeconds": { "type": "integer" },
            "maxInFlight": { "type": "integer" },
            "maxWaitersPerFetch": { "type": "integer" }
          }
        },
        "accessTokenTtlSeconds": { "$ref": "#/$defs/positiveInteger" },
        "refreshTokenTtlSeconds": { "$ref": "#/$defs/positiveInteger" },
        "consentTokenTtlSeconds": { "$ref": "#/$defs/positiveInteger" },
        "authorizationCodeTtlSeconds": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "headerValue": {
      "description": "A string is one occurrence; an array is distinct occurrences on the wire, never joined",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "headerName": {
      "type": "string",
      "description": "Lowercase HTTP field name",
      "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
    },
    "inboundRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/headerName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/headerValue"
          }
        },
        "body": {
          "description": "JSON value sent as the body; a string is sent verbatim"
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url",
            "headers",
            "body"
          ],
          "properties": {
            "method": {
              "type": "string",
              "pattern": "^[A-Z]+$"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "headers": {
              "type": "object",
              "description": "Partial lower-case outbound request-header matcher",
              "propertyNames": {
                "$ref": "#/$defs/headerName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/matcher"
              }
            },
            "body": {
              "$ref": "#/$defs/matcher"
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "headers",
            "body"
          ],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/headerName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/headerValue"
              }
            },
            "body": {
              "$ref": "#/$defs/bodyValue"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "result"],
            "properties": {
              "input": {
                "$ref": "#/$defs/bodyValue"
              },
              "result": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["ok", "identity"],
                    "properties": {
                      "ok": { "const": true },
                      "identity": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["subject"],
                        "properties": {
                          "subject": { "type": "string", "minLength": 1 },
                          "allowedScopes": { "$ref": "#/$defs/stringArray" },
                          "claims": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["ok", "reason"],
                    "properties": {
                      "ok": { "const": false },
                      "reason": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "outcome"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "outcome": {
                "oneOf": [
                  { "const": "allow" },
                  { "const": "deny" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["throws"],
                    "properties": {
                      "throws": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "protectedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredScope"],
      "properties": {
        "requiredScope": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "success": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "headers", "body"],
          "properties": {
            "status": { "type": "integer", "minimum": 200, "maximum": 299 },
            "headers": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/headerName"
              },
              "additionalProperties": { "$ref": "#/$defs/headerValue" }
            },
            "body": { "$ref": "#/$defs/bodyValue" }
          }
        }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurredAt", "event", "status"],
      "properties": {
        "occurredAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "event": { "type": "string", "minLength": 1 },
        "status": { "enum": ["success", "failure"] },
        "clientId": { "type": "string" },
        "subject": { "type": "string" },
        "resource": { "type": "string" },
        "scopes": { "$ref": "#/$defs/stringArray" },
        "redirectHost": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "ip": { "type": "string" },
        "selectedClientAuthMethod": { "const": "none" }
      }
    },
    "bodyValue": {
      "description": "Explicit body value or explicit absence",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["absent"],
          "properties": {
            "absent": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {}
          }
        }
      ]
    },
    "auditEventSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "occurredAt": { "type": "string" },
        "event": { "type": "string" },
        "status": { "enum": ["success", "failure"] },
        "clientId": { "type": "string" },
        "subject": { "type": "string" },
        "resource": { "type": "string" },
        "scopes": { "$ref": "#/$defs/stringArray" },
        "redirectHost": { "type": "string" },
        "reason": { "type": "string" },
        "ip": { "type": "string" },
        "selectedClientAuthMethod": { "const": "none" }
      }
    },
    "auditAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "absent"],
      "properties": {
        "events": {
          "type": "array",
          "description": "Exact ordered event list; no additional event is permitted",
          "items": { "$ref": "#/$defs/auditEvent" }
        },
        "absent": {
          "type": "array",
          "description": "Partial selectors that must match no emitted event",
          "items": { "$ref": "#/$defs/auditEventSelector" }
        }
      }
    },
    "stateAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "absent", "allowExtraRows"],
      "properties": {
        "rows": {
          "type": "object",
          "description": "Exact post-request rows by record kind",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "absent": {
          "type": "array",
          "description": "Row selectors that must match no row",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "where"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "where": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        },
        "allowExtraRows": {
          "const": false,
          "description": "Extra store rows are never accepted"
        }
      }
    },
    "presentMatcher": {
      "description": "A bare string is an exact match; an object holds exactly one of equals, RE2 matches, contains, or schema",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "equals": {},
            "matches": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "type": "object"
            }
          }
        }
      ]
    },
    "matcher": {
      "description": "A present-value matcher or an explicit absence assertion",
      "oneOf": [
        { "$ref": "#/$defs/presentMatcher" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["absent"],
          "properties": {
            "absent": { "const": true }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "receipt": {}
        },
        "required": [
          "receipt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "supersededBy": {}
        },
        "required": [
          "supersededBy"
        ]
      }
    }
  ]
}
