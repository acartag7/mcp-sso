{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acartag7/mcp-sso/fixtures/schema/fixture.schema.json",
  "title": "mcp-sso parity fixture",
  "description": "One executable statement of one contract clause. Governed by docs/contracts/19-parity-fixture-protocol.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile",
    "contract",
    "status",
    "given",
    "then"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "<NN>-<section-slug>/<clause>-<slug>; must equal the file path relative to fixtures/ without .json",
      "pattern": "^(0[1-9]|1[0-9])-[a-z0-9]+(-[a-z0-9]+)*/[0-9]+(\\.[0-9]+){0,2}[a-z]?-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "fixture",
        "boot"
      ],
      "description": "fixture sends one HTTP request; boot asserts application construction without a request"
    },
    "profile": {
      "enum": [
        "portable",
        "host"
      ],
      "description": "portable pins shared OAuth behavior; host pins the TypeScript reference envelope"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "clause",
        "quote"
      ],
      "properties": {
        "section": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-9])$"
        },
        "clause": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}[a-z]?$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "Verbatim contract sentence this fixture pins"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "frozen",
        "superseded"
      ]
    },
    "supersededBy": {
      "type": "string",
      "description": "Fixture id; required when status is superseded"
    },
    "notes": {
      "type": "string",
      "description": "What is deliberately not asserted and why"
    },
    "chain": {
      "$ref": "#/$defs/chain"
    },
    "given": {},
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/inboundRequest"
        }
      }
    },
    "then": {},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which implementation passed this fixture unchanged, at which version and commit, on which date. Required when status is frozen.",
      "required": [
        "implementation",
        "version",
        "commit",
        "date"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  },
  "$defs": {
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "step"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-9])-[a-z0-9]+(-[a-z0-9]+)*/[0-9]+(\\.[0-9]+){0,2}[a-z]?-[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "clock": {
      "type": "string",
      "description": "Canonical run timestamp, UTC ISO 8601 with exactly 3 ms digits (section 12.1)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "random": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed"
      ],
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1,
          "description": "UTF-8 input to the section 19.2 HMAC-SHA-256 byte stream; maximum 1,024 UTF-8 bytes"
        }
      }
    },
    "fixtureKeys": {
      "type": "object",
      "description": "Logical name to a PEM path under fixtures/keys/",
      "additionalProperties": false,
      "required": [
        "signingPrivate"
      ],
      "properties": {
        "signingPrivate": {
          "type": "string",
          "pattern": "^keys/[a-z0-9-]+\\.pem$"
        },
        "signingPublic": {
          "type": "string",
          "pattern": "^keys/[a-z0-9-]+\\.pem$"
        }
      }
    },
    "bootKeys": {
      "type": "object",
      "description": "A named private key is materialized only when supplied; omission can test a missing signing key",
      "additionalProperties": false,
      "properties": {
        "signingPrivate": {
          "type": "string",
          "pattern": "^keys/[a-z0-9-]+\\.pem$"
        },
        "signingPublic": {
          "type": "string",
          "pattern": "^keys/[a-z0-9-]+\\.pem$"
        }
      }
    },
    "httpGiven": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "clock",
        "random",
        "keys",
        "state",
        "http",
        "identity",
        "rateLimit",
        "protectedResource"
      ],
      "properties": {
        "config": { "$ref": "#/$defs/fixtureConfig" },
        "clock": { "$ref": "#/$defs/clock" },
        "random": { "$ref": "#/$defs/random" },
        "keys": { "$ref": "#/$defs/fixtureKeys" },
        "state": { "$ref": "#/$defs/logicalState" },
        "http": { "$ref": "#/$defs/httpScript" },
        "identity": { "$ref": "#/$defs/identity" },
        "rateLimit": { "$ref": "#/$defs/rateLimit" },
        "protectedResource": { "$ref": "#/$defs/protectedResource" }
      }
    },
    "bootGiven": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "config",
        "clock",
        "random",
        "keys",
        "state",
        "http",
        "identity",
        "rateLimit"
      ],
      "properties": {
        "entrypoint": {
          "enum": [
            "createBridgeConfig",
            "Bridge"
          ]
        },
        "config": {
          "description": "Literal JSON input to the named construction boundary; malformed values are not repaired"
        },
        "clock": { "$ref": "#/$defs/clock" },
        "random": { "$ref": "#/$defs/random" },
        "keys": { "$ref": "#/$defs/bootKeys" },
        "state": { "$ref": "#/$defs/logicalState" },
        "http": { "$ref": "#/$defs/httpScript" },
        "identity": { "$ref": "#/$defs/identity" },
        "rateLimit": { "$ref": "#/$defs/rateLimit" }
      }
    },
    "httpScript": {
      "type": "array",
      "description": "Every outbound exchange the implementation may perform; an unmatched outbound call fails the fixture",
      "items": {
        "$ref": "#/$defs/exchange"
      }
    },
    "httpThen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "outbound"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "description": "Lower-case header name to matcher; a header not listed is not asserted",
          "propertyNames": {
            "$ref": "#/$defs/headerName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/matcher"
          }
        },
        "body": { "$ref": "#/$defs/matcher" },
        "audit": { "$ref": "#/$defs/auditAssertion" },
        "state": { "$ref": "#/$defs/stateAssertion" },
        "captures": {
          "type": "array",
          "items": { "$ref": "#/$defs/capture" }
        },
        "outbound": { "$ref": "#/$defs/outboundAssertion" }
      }
    },
    "bootThen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot",
        "outbound"
      ],
      "properties": {
        "boot": { "$ref": "#/$defs/bootAssertion" },
        "audit": { "$ref": "#/$defs/auditAssertion" },
        "state": { "$ref": "#/$defs/stateAssertion" },
        "outbound": { "$ref": "#/$defs/outboundAssertion" }
      }
    },
    "bootAssertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": { "const": "accepted" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "error"
          ],
          "properties": {
            "outcome": { "const": "rejected" },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "name": { "$ref": "#/$defs/presentMatcher" },
                "message": { "$ref": "#/$defs/presentMatcher" }
              }
            }
          }
        }
      ]
    },
    "outboundAssertion": {
      "type": "array",
      "description": "Exact ordered list of outbound calls that MUST have happened; empty means none",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "url",
          "headers",
          "body"
        ],
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^[A-Z]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "headers": {
            "type": "object",
            "description": "Exact outbound header-name set; each lower-case name maps to a value matcher",
            "propertyNames": {
              "$ref": "#/$defs/headerName"
            },
            "additionalProperties": {
              "$ref": "#/$defs/presentMatcher"
            }
          },
          "body": { "$ref": "#/$defs/matcher" }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bodyPointer"
              ],
              "properties": {
                "bodyPointer": {
                  "type": "string",
                  "pattern": "^(?:$|/)"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "header",
                "urlQuery"
              ],
              "properties": {
                "header": { "$ref": "#/$defs/headerName" },
                "urlQuery": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "jwt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "header",
            "claims"
          ],
          "properties": {
            "key": { "const": "signingPublic" },
            "header": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alg",
                "kid",
                "typ"
              ],
              "properties": {
                "alg": { "const": "ES256" },
                "kid": { "type": "string", "minLength": 1 },
                "typ": { "const": "JWT" }
              }
            },
            "claims": {
              "type": "object"
            }
          }
        }
      }
    },
    "captureReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$capture"
      ],
      "properties": {
        "$capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixture",
            "name",
            "format"
          ],
          "properties": {
            "fixture": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-9])-[a-z0-9]+(-[a-z0-9]+)*/[0-9]+(\\.[0-9]+){0,2}[a-z]?-[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "format": {
              "enum": [
                "raw",
                "bearer"
              ]
            }
          }
        }
      }
    },
    "logicalState": {
      "type": "object",
      "description": "Portable logical StorePort and stored-DCR ClientStore rows; omitted record kinds are empty",
      "additionalProperties": false,
      "properties": {
        "authorization_code": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationCodeRow" }
        },
        "consent_jti": {
          "type": "array",
          "items": { "$ref": "#/$defs/consentJtiRow" }
        },
        "refresh_token": {
          "type": "array",
          "items": { "$ref": "#/$defs/refreshTokenRow" }
        },
        "revoked_family": {
          "type": "array",
          "items": { "$ref": "#/$defs/revokedFamilyRow" }
        },
        "client_registration": {
          "type": "array",
          "items": { "$ref": "#/$defs/clientRegistrationRow" }
        },
        "store_instance": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/storeInstanceRow" }
        }
      }
    },
    "authorizationCodeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_hash",
        "client_id",
        "subject",
        "redirect_uri",
        "resource",
        "scopes",
        "code_challenge",
        "code_challenge_method",
        "expires_at"
      ],
      "properties": {
        "code_hash": { "$ref": "#/$defs/sha256Hex" },
        "client_id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "redirect_uri": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "scopes": { "$ref": "#/$defs/stringArray" },
        "code_challenge": { "type": "string", "minLength": 1 },
        "code_challenge_method": { "const": "S256" },
        "expires_at": { "$ref": "#/$defs/utcTimestamp" },
        "grant_generation": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "consentJtiRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jti",
        "expires_at"
      ],
      "properties": {
        "jti": { "type": "string", "minLength": 1 },
        "expires_at": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "refreshTokenRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_hash",
        "family_id",
        "client_id",
        "subject",
        "resource",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "token_hash": { "$ref": "#/$defs/sha256Hex" },
        "family_id": { "type": "string", "minLength": 1 },
        "previous_token_hash": { "$ref": "#/$defs/sha256Hex" },
        "client_id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "scopes": { "$ref": "#/$defs/stringArray" },
        "expires_at": { "$ref": "#/$defs/utcTimestamp" },
        "consumed_at": { "$ref": "#/$defs/utcTimestamp" },
        "grant_generation": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "revokedFamilyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "resource",
        "revoked_at"
      ],
      "properties": {
        "family_id": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "revoked_at": { "$ref": "#/$defs/utcTimestamp" },
        "grant_generation": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "clientRegistrationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "redirect_uris",
        "application_type",
        "issued_at_epoch"
      ],
      "properties": {
        "client_id": { "type": "string", "minLength": 1 },
        "redirect_uris": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "application_type": {
          "enum": [
            "native",
            "web"
          ]
        },
        "issued_at_epoch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "storeInstanceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,128}$"
        }
      }
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "fixtureConfig": {
      "type": "object",
      "description": "Complete JSON fixture configuration for section 05. given.keys.signingPrivate materializes signingPrivateJwk; stored mode materializes its store from given.state.",
      "additionalProperties": false,
      "required": [
        "issuer",
        "resource",
        "consentSigningSecret",
        "redirectAllowlist",
        "scopeCatalog",
        "defaultScopes",
        "allowedOrigins",
        "dcr",
        "accessTokenTtlSeconds",
        "refreshTokenTtlSeconds",
        "consentTokenTtlSeconds",
        "authorizationCodeTtlSeconds"
      ],
      "properties": {
        "issuer": { "type": "string", "format": "uri" },
        "resource": { "type": "string", "format": "uri" },
        "consentSigningSecret": { "type": "string", "minLength": 32 },
        "signingKeyId": { "type": "string", "minLength": 1 },
        "redirectAllowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "redirectAllowlistMode": { "enum": ["extend", "replace"] },
        "scopeCatalog": { "$ref": "#/$defs/stringArray" },
        "defaultScopes": { "$ref": "#/$defs/stringArray" },
        "scopeHierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "implications"],
          "properties": {
            "resource": { "type": "string", "format": "uri" },
            "implications": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["granted", "implies"],
                "properties": {
                  "granted": { "type": "string" },
                  "implies": { "$ref": "#/$defs/stringArray" }
                }
              }
            }
          }
        },
        "allowedOrigins": { "$ref": "#/$defs/stringArray" },
        "dcr": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "stateless" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "stored" } }
            }
          ]
        },
        "dev": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowInsecureLocalhost"],
          "properties": { "allowInsecureLocalhost": { "type": "boolean" } }
        },
        "clientCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "cimd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "const": true },
            "maxDocumentBytes": { "type": "integer" },
            "fetchTimeoutMs": { "type": "integer" },
            "cacheTtlCapSeconds": { "type": "integer" },
            "maxInFlight": { "type": "integer" },
            "maxWaitersPerFetch": { "type": "integer" }
          }
        },
        "accessTokenTtlSeconds": { "$ref": "#/$defs/positiveInteger" },
        "refreshTokenTtlSeconds": { "$ref": "#/$defs/positiveInteger" },
        "consentTokenTtlSeconds": { "$ref": "#/$defs/positiveInteger" },
        "authorizationCodeTtlSeconds": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "headerValue": {
      "description": "A string is one occurrence; an array is distinct occurrences on the wire, never joined",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/captureReference"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/captureReference" }
            ]
          }
        }
      ]
    },
    "responseHeaderValue": {
      "description": "A response header is literal: a string is one occurrence; an array is distinct occurrences on the wire, never joined",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "headerName": {
      "type": "string",
      "description": "Lowercase HTTP field name",
      "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
    },
    "inboundRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/headerName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/headerValue"
          }
        },
        "body": {
          "$ref": "#/$defs/inboundBody"
        }
      }
    },
    "inboundBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "json"
          ],
          "properties": {
            "json": {
              "description": "JSON value serialized after recursive capture replacement"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form"
          ],
          "properties": {
            "form": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/formField"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "oneOf": [
                { "type": "string" },
                { "$ref": "#/$defs/captureReference" }
              ]
            }
          }
        }
      ]
    },
    "formField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/captureReference" }
          ]
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url",
            "headers",
            "body"
          ],
          "properties": {
            "method": {
              "type": "string",
              "pattern": "^[A-Z]+$"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "headers": {
              "type": "object",
              "description": "Partial lower-case outbound request-header matcher",
              "propertyNames": {
                "$ref": "#/$defs/headerName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/matcher"
              }
            },
            "body": {
              "$ref": "#/$defs/matcher"
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "headers",
            "body"
          ],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "headers": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/headerName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/responseHeaderValue"
              }
            },
            "body": {
              "$ref": "#/$defs/bodyValue"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input"],
            "properties": {
              "input": {
                "$ref": "#/$defs/bodyValue"
              },
              "result": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["ok", "identity"],
                    "properties": {
                      "ok": { "const": true },
                      "identity": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["subject"],
                        "properties": {
                          "subject": { "type": "string", "minLength": 1 },
                          "allowedScopes": { "$ref": "#/$defs/stringArray" },
                          "claims": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["ok", "reason"],
                    "properties": {
                      "ok": { "const": false },
                      "reason": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              },
              "throw": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "code",
                      "description",
                      "status"
                    ],
                    "properties": {
                      "kind": { "const": "oauth" },
                      "code": { "type": "string", "minLength": 1 },
                      "description": { "type": "string" },
                      "status": {
                        "enum": [
                          401,
                          403
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": { "const": "generic" }
                    }
                  }
                ]
              }
            },
            "oneOf": [
              {
                "properties": { "result": {} },
                "required": ["result"]
              },
              {
                "properties": { "throw": {} },
                "required": ["throw"]
              }
            ]
          }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "outcome"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "outcome": {
                "oneOf": [
                  { "const": "allow" },
                  { "const": "deny" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["throws"],
                    "properties": {
                      "throws": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "protectedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredScope"],
      "properties": {
        "requiredScope": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "success": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "headers", "body"],
          "properties": {
            "status": { "type": "integer", "minimum": 200, "maximum": 299 },
            "headers": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/headerName"
              },
              "additionalProperties": { "$ref": "#/$defs/responseHeaderValue" }
            },
            "body": { "$ref": "#/$defs/bodyValue" }
          }
        }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurredAt", "event", "status"],
      "properties": {
        "occurredAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "event": { "type": "string", "minLength": 1 },
        "status": { "enum": ["success", "failure"] },
        "clientId": { "type": "string" },
        "subject": { "type": "string" },
        "resource": { "type": "string" },
        "scopes": { "$ref": "#/$defs/stringArray" },
        "redirectHost": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "ip": { "type": "string" },
        "selectedClientAuthMethod": { "const": "none" }
      }
    },
    "bodyValue": {
      "description": "Explicit body value or explicit absence",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["absent"],
          "properties": {
            "absent": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {}
          }
        }
      ]
    },
    "auditEventSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "occurredAt": { "type": "string" },
        "event": { "type": "string" },
        "status": { "enum": ["success", "failure"] },
        "clientId": { "type": "string" },
        "subject": { "type": "string" },
        "resource": { "type": "string" },
        "scopes": { "$ref": "#/$defs/stringArray" },
        "redirectHost": { "type": "string" },
        "reason": { "type": "string" },
        "ip": { "type": "string" },
        "selectedClientAuthMethod": { "const": "none" }
      }
    },
    "auditAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "absent"],
      "properties": {
        "events": {
          "type": "array",
          "description": "Exact ordered event list; no additional event is permitted",
          "items": { "$ref": "#/$defs/auditEvent" }
        },
        "absent": {
          "type": "array",
          "description": "Partial selectors that must match no emitted event",
          "items": { "$ref": "#/$defs/auditEventSelector" }
        }
      }
    },
    "stateAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rows", "absent"],
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "contains"
          ]
        },
        "rows": {
          "$ref": "#/$defs/logicalState"
        },
        "absent": {
          "type": "array",
          "description": "Row selectors that must match no row",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "where"],
            "properties": {
              "kind": {
                "enum": [
                  "authorization_code",
                  "consent_jti",
                  "refresh_token",
                  "revoked_family",
                  "client_registration",
                  "store_instance"
                ]
              },
              "where": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "presentMatcher": {
      "description": "A bare string is an exact match; an object holds exactly one of equals, RE2 matches, contains, or schema",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "equals": {},
            "matches": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "type": "object"
            }
          }
        }
      ]
    },
    "matcher": {
      "description": "A present-value matcher or an explicit absence assertion",
      "oneOf": [
        { "$ref": "#/$defs/presentMatcher" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["absent"],
          "properties": {
            "absent": { "const": true }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fixture"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "when"
        ],
        "properties": {
          "when": {},
          "given": { "$ref": "#/$defs/httpGiven" },
          "then": { "$ref": "#/$defs/httpThen" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "boot"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "required": [
            "when"
          ]
        },
        "properties": {
          "given": { "$ref": "#/$defs/bootGiven" },
          "then": { "$ref": "#/$defs/bootThen" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "boot" },
          "profile": { "const": "portable" }
        },
        "required": [
          "kind",
          "profile"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "then": {
            "type": "object",
            "properties": {
              "boot": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "object",
                    "not": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": ["name"],
                          "properties": { "name": { "$ref": "#/$defs/presentMatcher" } }
                        },
                        {
                          "type": "object",
                          "required": ["message"],
                          "properties": { "message": { "$ref": "#/$defs/presentMatcher" } }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "receipt": {}
        },
        "required": [
          "receipt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "supersededBy": {}
        },
        "required": [
          "supersededBy"
        ]
      }
    }
  ]
}
